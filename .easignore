# EAS Build upload rules. Keep local secrets and generated folders out of the
# build archive, but upload Firebase client config used by app.config.ts.

# dependencies
node_modules/

# Expo
.expo/
.codex
.playwright-mcp/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local
!.env.example

# Firebase local service config
google-service.json
firebase/GoogleService-Info.plist

# Supabase local state
supabase/.branches/
supabase/.temp/
supabase/.env

# typescript
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]

# tests
coverage/

# generated native folders
/ios
/android
